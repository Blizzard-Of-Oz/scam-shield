{
  "name": "scam-shield",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "node scripts/db-generate.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:merge-legacy": "node --experimental-strip-types scripts/mergeLegacyDuplicates.ts"
  },
  "dependencies": {
    "next": "^14.2.25",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.17.19",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "^14.2.25",
    "postcss": "8.5.1",
    "prettier": "3.5.0",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vitest": "3.0.5"
  }
}
