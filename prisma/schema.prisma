generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ScamReport {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  verdict   String
  score     Int
  scamType  String?
  note      String?
  urls      String
  urlHash   String   @default("")
  count     Int      @default(1)
  updatedAt DateTime @updatedAt

  @@index([urlHash])
}
